{
  "name": "cinenova",
  "version": "0.1.0",
  "private": true,
  "description": "CineNova premium, rights-aware streaming platform monorepo.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "pnpm audit --audit-level high",
    "db:generate": "pnpm --filter @cinenova/web prisma:generate",
    "db:migrate": "pnpm --filter @cinenova/web prisma:migrate",
    "db:seed": "pnpm --filter @cinenova/web prisma:seed"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "postcss": "8.5.25",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.1",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "vite": "^6.4.3",
      "sharp": "0.35.3"
    }
  }
}
