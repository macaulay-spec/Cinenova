# CineNova local development placeholders only. Do not commit real secrets.
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=CineNova
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Persistence backend: memory (default, no DB) or postgres (requires prisma generate + DATABASE_URL).
PERSISTENCE=memory
DATABASE_URL=postgresql://cinenova:cinenova@localhost:5432/cinenova?schema=public
REDIS_URL=redis://localhost:6379

# Session and CSRF secrets. Required in production (config parser enforces).
# SESSION_SECRET signs/resolves sessions; CSRF_SECRET signs CSRF tokens bound to
# sessions. Both must be >=32 random bytes and stored in a secret manager.
SESSION_SECRET=replace-with-a-32-byte-random-secret
CSRF_SECRET=replace-with-a-32-byte-random-secret
ENCRYPTION_KEY=replace-with-a-managed-kms-or-vault-reference

# Provider routing. GZMovie is the active catalogue backbone. Mock is the fallback.
# Keep GZMOVIE_LEGACY_API_KEY server-side only (never in git, logs, or browser bundles).
PROVIDER_ROUTING=gzmovie
GZMOVIE_ENABLED=true
GZMOVIE_BASE_URL=https://gzmovieboxapi.septorch.tech
GZMOVIE_LEGACY_API_KEY=Godszeal 
GZMOVIE_REQUEST_TIMEOUT_MS=10000

# Payment provider placeholders; store real values in a secret manager.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=replace-only-in-secret-manager
PAYSTACK_SECRET_KEY=replace-only-in-secret-manager
FLUTTERWAVE_SECRET_KEY=replace-only-in-secret-manager
WEBHOOK_SIGNING_SECRET=replace-only-in-secret-manager

# Observability placeholders.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
